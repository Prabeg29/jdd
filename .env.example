# Local settings, read by pydantic-settings (src/shared/settings/base.py).
# Copy to .env. Nested fields use "__": DATABASE__HOST is settings.database.host.
# In Lambda the same fields come from Terraform (AWS__*) and SSM Parameter Store.

AWS__REGION=ap-southeast-2
AWS__BUCKET=
AWS__INGEST_QUEUE_URL=
AWS__INGEST_DLQ_URL=

# Local docker Postgres (make db-up). For migrations against Neon, use the direct
# (non-pooler) host and DATABASE__SSLMODE=require.
DATABASE__HOST=127.0.0.1
DATABASE__PORT=5433
DATABASE__NAME=job_discovery
DATABASE__USER=postgres
DATABASE__PASSWORD=postgres
DATABASE__SSLMODE=disable

ANTHROPIC__API_KEY=
SLACK__BOT_TOKEN=

LOG__LEVEL=INFO
